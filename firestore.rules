rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Wallet friends - existing
    match /wallets/{walletId}/friends/{friendId} {
      allow read: if true;
      allow write: if true;
    }

    // Auth passwords
    match /auth/{walletId} {
      allow read: if true;
    }

    // Bets
    match /bets/{betId} {
      allow read: if true;
      allow write: if true;
    }

    // Transactions
    match /transactions/{txId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
